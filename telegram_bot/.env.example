# Copy thành .env rồi điền. KHÔNG chia sẻ file .env.
TELEGRAM_BOT_TOKEN=
# Lấy bằng cách nhắn /id cho bot, nhiều ID cách nhau bằng dấu phẩy
ALLOWED_CHAT_IDS=
# Key OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Model bắt buộc
AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free
# Threads API (xem README, mục Threads)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
AUTO_PUBLISH_THREADS=true
